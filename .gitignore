# Local environments and Python-generated files
**/.venv/
**/venv/
**/env/
**/.tox/
**/.nox/
**/.mypy_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/.ipynb_checkpoints/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.ty_cache/
**/.cache/
**/*.egg-info/
**/build/
**/dist/

# Secrets and machine-local configuration
**/.env
**/.env.*
!**/.env.example
**/.streamlit/secrets.toml
**/*.key
**/*.secret
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/credentials.json
**/service-account*.json
**/.netrc
**/_netrc
**/.npmrc
**/.pypirc

# IDE and Windows-generated files
**/.idea/
**/.vscode/
**/*.code-workspace
**/Thumbs.db
**/ehthumbs.db
**/Desktop.ini
**/$RECYCLE.BIN/

# Model weights, embedding indexes, and vector database storage
**/models/
**/checkpoints/
**/*.gguf
**/*.safetensors
**/*.onnx
**/*.pt
**/*.pth
**/*.ckpt
**/*.h5
**/*.hdf5
**/*.tflite
**/pytorch_model*.bin
**/adapter_model*.bin
**/*.faiss
**/*.index
**/data/indexes/**
!**/data/indexes/.gitkeep
**/qdrant_storage/
**/qdrant_db/
**/qdrant/storage/
**/data/qdrant/
**/data/embeddings/**
!**/data/embeddings/.gitkeep
**/data/cache/**
!**/data/cache/.gitkeep

# Private inputs and runtime/audit dumps can contain documents and prompts
**/data/inbox/**
!**/data/inbox/.gitkeep
**/data/audit/
**/audit-dumps/
**/audit_dumps/
**/prompt-dumps/
**/prompt_dumps/
**/data/crops/**
!**/data/crops/.gitkeep
**/data/parse/**
!**/data/parse/.gitkeep
**/data/annotated/**
!**/data/annotated/.gitkeep

# Local agent and code-graph state
**/.code-review-graph/
**/.codegraph/
**/.remember/
**/.playwright-mcp/
**/.git.empty-backup/
**/.aiwg/
**/.claude/settings.local.json

# Generated sample/runtime output
/1-Production-RAG-Pipeline/data/processed/*
!/1-Production-RAG-Pipeline/data/processed/.gitkeep
/3-Context-Assembly-Service/out/*
!/3-Context-Assembly-Service/out/.gitkeep

# Generated training artifacts
/8-Fine-Tuning-Pipeline/data/processed/
/8-Fine-Tuning-Pipeline/outputs/
/8-Fine-Tuning-Pipeline/reports/

# Generated document-extraction artifacts
/16-Agentic-Document-Extraction/data/audit/
/16-Agentic-Document-Extraction/data/committed/
/16-Agentic-Document-Extraction/data/review/

# Common runtime artifacts not already covered by child ignore files
**/*.db
**/*.sqlite
**/*.sqlite3
**/logs/*.jsonl
